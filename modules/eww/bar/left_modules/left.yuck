(deflisten workspace :initial `[]` "./bin/workspaces")

(defwidget left []
  (box :orientation "h" :space-evenly false
       (button :class "menu_btn" :onclick { get_env("LAUNCHER") } "")
       (workspaces)))


(defwidget workspaces []
  (box
   :class "workspaces" :space-evenly false :orientation "h" :vexpand true
   (for ws in workspace
	(button :class { ws[2] == true ? "ws_button_focused" : "ws_button" }
		:onclick `${get_env("CHANGE_WS")} ${ws[0]}`
		`${ws[1]}`))))
