[general]
mode = viewer
size = fullscreen

[viewer]
scale = optimal
transparency = grid
antialiasing = mks13
window = #000000
loop = no
history = 1
preload = 1


[list]
order = alpha
recursive = no
all = yes


[font]
name = Hack Nerd Font
size = 14
shadow = #000000a0


[info]
show = yes
info_timeout = 0

[info.viewer]
top_left = name,format,filesize,imagesize,exif
top_right = index
bottom_left = scale
bottom_right = status

[keys.gallery]
Shift+? = help

[keys.viewer]
Shift+? = help

Left = prev_file
Right = next_file
Shift+Left = first_file
Shift+Right = last_file

Shift+o = prev_frame
o = next_frame
s = animation
f = fullscreen
h = step_left 5
l = step_right 5
k = step_up 5
j = step_down 5

Equal = zoom +10
Plus = zoom +10
Minus = zoom -10
BackSpace = zoom optimal
bracketleft = rotate_left
bracketright = rotate_right
m = flip_vertical
Shift+m = flip_horizontal
a = antialiasing
i = info

Escape = exit
q = exit