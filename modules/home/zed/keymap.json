[
  {
    "bindings": {
      "ctrl-c ctrl-w s": "workspace::Open",
      "ctrl-c ctrl-w c": "workspace::CloseProject",
      "alt-0": "project_panel::Toggle",
      "ctrl-x m": "outline_panel::Toggle",
      "ctrl-x g": "git_panel::Toggle",
      "ctrl-x ctrl-c": "zed::Quit",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-down": "editor::MoveToEndOfParagraph",
      "alt-up": "editor::MoveToStartOfParagraph",
      "ctrl-alt-/": "editor::Redo",
      "ctrl-a": ["editor::MoveToBeginningOfLine", { "stop_at_soft_wraps": false, "stop_at_indent": false }],
      "alt-backspace": "editor::DeleteToPreviousSubwordStart",
      "alt-m": ["editor::MoveToBeginningOfLine", { "stop_at_soft_wraps": false, "stop_at_indent": true }],
      "alt-;": ["editor::ToggleComments", { "advance_downwards": true }],
      "ctrl-x h": "editor::SelectAll",
    },
  },
  {
    "context": "(Editor && selection_mode)",
    "bindings": {
      "alt-down": "editor::SelectToEndOfParagraph",
      "alt-up": "editor::SelectToStartOfParagraph",
      "alt-right": "editor::SelectToNextSubwordEnd",
      "alt-left": "editor::SelectToPreviousSubwordStart",
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-g ctrl-g": "go_to_line::Toggle",
      "ctrl-s": "buffer_search::Deploy",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-t": "terminal_panel::Toggle",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "tab": "project_panel::Open",
      "shift-c": "project_panel::Copy",
      "shift-p": "project_panel::Paste",
      "shift-x": "project_panel::Cut",
      "shift-d": ["project_panel::Trash", { "skip_prompt": true }],
      "shift-r": "project_panel::Rename",
      "c f": "project_panel::NewFile",
      "c d": "project_panel::NewDirectory",
    },
  },
  {
    "context": "GitPanel && !Editor",
    "bindings": {
      "q": "git_panel::Close",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-x": "command_palette::Toggle",
      "ctrl-x ctrl-s": "workspace::Save",
      "ctrl-x b": "file_finder::Toggle",
      "ctrl-x ctrl-b": "file_finder::Toggle",
      "ctrl-x o": "workspace::ActivateNextPane",
      "ctrl-x 4 0": "pane::JoinIntoNext",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-x k": ["pane::CloseActiveItem", { "close_pinned": false }],
      "ctrl-x 1": ["pane::CloseOtherItems", { "close_pinned": false }],
      "ctrl-x 3": "pane::SplitVertical",
      "ctrl-x 2": "pane::SplitHorizontal",
    },
  },
]
