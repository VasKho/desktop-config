# Menu
menu.border.color: #353535

menu.title.bg: Solid Flat
menu.title.bg.color: #ffdfd6
menu.title.bg.shadow: 0
menu.title.text.color: #1b181b
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #ffdfd6
menu.items.text.color: #1b181b
menu.items.disabled.text.color: #544949

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #ffb5da
menu.items.active.text.color: #1b181b

menu.separator.color: #544949
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #ffdfd6

# Active window
window.active.border.color: #ff3ea5


window.active.title.bg: flat solid
window.active.title.bg.color: #ffdfd6
window.active.title.separator.color: #ffdfd6
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #1b181b

window.active.handle.bg: flat solid
window.active.handle.bg.color: #ffdfd6

window.active.grip.bg: flat solid
window.active.grip.bg.color: #ffdfd6

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #ffdfd6
window.active.button.unpressed.image.color: #1b181b

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #ffb5da
window.active.button.pressed.image.color: #171517

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #ffdfd6
window.active.button.disabled.image.color: #544949

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #ffdfd6
window.active.button.hover.image.color: #ffb5da

#window.active.button.toggled.bg: #ffb5da
#window.active.button.toggled.image.color: #171517

# Inactive window
window.inactive.border.color: #e7dbdb

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #ffdfd6
window.inactive.title.separator.color: #ffdfd6
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #544949

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #ffdfd6

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #ffdfd6

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #ffdfd6
window.inactive.button.unpressed.image.color: #544949

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #ffb5da
window.inactive.button.pressed.image.color: #171517

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #544949
window.inactive.button.disabled.image.color: #ffdfd6

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #ffdfd6
window.inactive.button.hover.image.color: #ffb5da


# OSD
osd.border.width: 1
osd.border.color: #ffb5da

osd.bg: flat solid
osd.bg.color: #ffdfd6
osd.label.bg: flat solid
osd.label.bg.color: #ffdfd6
osd.label.text.color: #1b181b

# OSD
osd.bg: Solid Flat
osd.bg.color: #ffdfd6
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #ffb5da
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #fdf0ed

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #ffc0d9
#osd.button.unpressed.*.border.color: #353535

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #ffb5da
#osd.button.pressed.*.border.color: #171517

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #353535
#osd.button.focused.*.border.color: #fdf0ed

osd.button.focused.box.color: #ffb5da


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 5
padding.width: 8
padding.height: 5
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
