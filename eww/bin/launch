#!/usr/bin/env bash

CONFIG_ROOT=$(cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && cd .. && pwd)

if [[ "${1}" == "start" ]]; then
    if [[ -f "${CONFIG_ROOT}/.env" ]]; then
	source "${CONFIG_ROOT}/.env"
    fi
    eww daemon
    eww open-many bar
    "${CONFIG_ROOT}/bin/volume"
    "${CONFIG_ROOT}/bin/backlight"
    "${CONFIG_ROOT}/bin/mic"
elif [[ "${1}" == "stop" ]]; then
    killall eww
fi
