;; Reveal variables
(defvar cal-rev false)
(defvar time-rev false)
(defvar micro-rev false)

;; Value variables
(defvar backlight-value 0)
(defvar volume-value 0)

;; Style variables
(defvar wifi-color "")
(defvar volume-color "")
(defvar cpu-animation "")
(defvar memory-animation "")
(defvar battery-animation "")

;; Poll valiables
(defpoll wifi-status :initial "./bin/wifi" :interval "5s" "./bin/wifi")
(defpoll cpu :initial "./bin/cpu" :interval "7s" "./bin/cpu")
(defpoll memory :initial "./bin/memory" :interval "7s" "./bin/memory")
(defpoll battery :initial "./bin/battery" :interval "3s" "./bin/battery")

(defwidget right []
  (box :halign "end" :class "right_modules" :space-evenly false
       (cpu)
       (memory)
       (battery)
       (wifi)
       (sound)
       (micro)
       (backlight)
       (tray)
       (clock-module)))

(defwidget cpu []
  (tooltip
   (label :text { jq(EWW_CPU.cores, "[.[] | \"\\(.core):\\t\\(.usage)\"] | join(\"\\n\")", "r") })
   (button :class { cpu-animation != "" ? "${cpu-animation}" : "button" }
	   :onclick { get_env("PROFILER") }
	   "󰘚 ${cpu}%")))

(defwidget memory []
  (tooltip
   (label :text { formatbytes(floor(EWW_RAM.used_mem), false, "iec") })
   (button :class { memory-animation != "" ? "${memory-animation}" : "button" }
	   :onclick { get_env("PROFILER") }
	   " ${memory}%")))

(defwidget battery []
  (label :class { battery-animation != "" ? "${battery-animation}" : "button" }
	 :text "${battery}"))

(defwidget wifi []
  (button :style { wifi-color != "" ? "color: ${wifi-color}" : "" }
	  :class "wifi"
	  :onclick { get_env("NETWORK") }
	  "${wifi-status}"))

(defwidget sound []
  (eventbox
   :style { volume-color != "" ? "color: ${volume-color}" : "" }
   :class "volume-box"
   :onhover "./bin/volume"
   :onscroll "./bin/volume {} 1"
   (box :space-evenly false :orientation "h"
	(label :class "button" :text "${volume-value}"))))

(defwidget micro []
  (revealer
   :transition "slideleft"
   :reveal micro-rev
   :duration "0.43s"
   (label :class "button" :text "")))

(defwidget backlight []
  (eventbox
   :class "backlight-box"
   :onhover "./bin/backlight"
   :onscroll "./bin/backlight {} 2"
   (box :space-evenly false :orientation "h"
	(label :class "button" :text "${backlight-value}"))))

(defwidget tray []
  (systray
   :class "tray"
   :spacing "10"
   :orientation "h"
   :icon-size "22"))

(defwidget clock-module []
  (eventbox
   :class "date-time"
   :onhover "${EWW_CMD} update time-rev=true"
   :onhoverlost "${EWW_CMD} update time-rev=false"
   :onclick {cal-rev ?
	     "${EWW_CMD} update cal-rev=false && ${EWW_CMD} close calendar"
	     : "${EWW_CMD} open calendar && ${EWW_CMD} update cal-rev=true"}
   (box :space-evenly false :orientation "h"
	(label :class "time-btn" :text { formattime(EWW_TIME, "%H:%M") })
	(revealer
	 :transition "slideleft"
	 :reveal time-rev
	 :duration "0.43s"
	 (label :class "date-btn" :text { formattime(EWW_TIME, "%A %d %B %Y") })))))
